[
  {
    "use_key_equivalents": true,
    "bindings": {
      "ctrl->": "editor::Indent",
      "ctrl-<": "editor::Outdent"
    }
  },
  {
    "context": "FileFinder || (FileFinder > Picker > Editor) || (FileFinder > Picker > menu)",
    "use_key_equivalents": true,
    "bindings": {
      "cmd-shift-p": "file_finder::SelectPrevious",
      "cmd-j": "pane::SplitDown",
      "cmd-k": "pane::SplitUp",
      "cmd-h": "pane::SplitLeft",
      "cmd-l": "pane::SplitRight",
      "ctrl-tab": "menu::SelectNext",
      "ctrl-shift-tab": "menu::SelectPrevious"
    }
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "shift-s": ["vim::PushAddSurrounds", {}]
    }
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "space k": "editor::SelectLargerSyntaxNode",
      "space j": "editor::SelectSmallerSyntaxNode"
    }
  },
  {
    "context": "VimControl && !menu && vim_mode != operator",
    "bindings": {
      "w": "vim::NextSubwordStart",
      "b": "vim::PreviousSubwordStart",
      "e": "vim::NextSubwordEnd",
      "E": "vim::NextWordEnd",
      "B": "vim::PreviousWordEnd",
      "g e": "vim::PreviousSubwordEnd"
    }
  },
  {
    "context": "Editor && (showing_context_menu || showing_completions)",
    "bindings": {
      "tab": "editor::ContextMenuNext",
      "shift-tab": "editor::ContextMenuPrevious"
    }
  },
  {
    "context": "Editor && (showing_context_menu || showing_completions)",
    "bindings": {
      "tab": "editor::ContextMenuNext",
      "shift-tab": "editor::ContextMenuPrevious"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "shift shift": "file_finder::Toggle",
      "alt-g": ["task::Spawn", { "task_name": "generate_.mli_file" }]
    }
  },
  {
    "context": "Editor && !menu",
    "bindings": {
      "ctrl-y": "editor::Undo",
      "ctrl-f": "buffer_search::Deploy",
      "ctrl-o": "workspace::Open"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-k": "assistant::InlineAssist",
      "cmd-r": "search::ToggleReplace",
      "ctrl-r": "task::Rerun",
      "shift-f6": "editor::Rename",
      "alt-enter": "editor::ToggleCodeActions"
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "enter": "project_panel::Open",
      "cmd-backspace": ["project_panel::Trash", { "skip_prompt": false }],
      "backspace": ["project_panel::Trash", { "skip_prompt": false }],
      "delete": ["project_panel::Trash", { "skip_prompt": false }],
      "shift-delete": ["project_panel::Delete", { "skip_prompt": false }],
      "shift-f6": "project_panel::Rename"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-n": ["terminal::SendKeystroke", "ctrl-n"]
    }
  }
]
